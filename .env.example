# 复制为 .env 后按需修改。不填 key 也能跑:默认 mock(固定剧本、不花钱)。
LLM_PROVIDER=mock
LLM_MODEL=mock-small
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_PRICE_PER1K=0.001
# 真实模型示例(任一 OpenAI 兼容服务),以 DeepSeek 为例:
#   LLM_PROVIDER=openai
#   LLM_MODEL=deepseek-chat
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_API_KEY=sk-...
# Anthropic(Claude)示例:默认开启的隐藏思考会吃掉 max_tokens、截断答案,需关掉:
#   LLM_MODEL=claude-haiku-5-5
#   OPENAI_BASE_URL=https://api.anthropic.com/v1
#   OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 厂商专有请求参数(JSON,合并进请求体),不需要就留空
OPENAI_EXTRA_BODY=
# 网页搜索:填了走 Tavily(质量好,免费每月 1000 次,tavily.com 申请);留空则用 DuckDuckGo(免 key,偶尔被限流)
TAVILY_API_KEY=
# mock 模式每次调用的模拟耗时(毫秒),便于在页面看清每一步、演示杀 worker
LLM_MOCK_DELAY_MS=1500
# RAG 服务的宿主机端口(8000 被占用时改掉)
RAG_PORT=8000
